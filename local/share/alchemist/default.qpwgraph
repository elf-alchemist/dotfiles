<!DOCTYPE patchbay>
<patchbay name="default" version="0.8.2">
 <items>
  <item node-type="pipewire" port-type="pipewire-audio">
   <output node="nuked-sc55" port="nuked-sc55:output_FL"/>
   <input node="K07" port="K07:playback_FL"/>
  </item>
  <item node-type="pipewire" port-type="pipewire-audio">
   <output node="woof" port="woof:output_FR"/>
   <input node="Built-in Audio Analog Stereo" port="ALC257 Analog:playback_FR"/>
  </item>
  <item node-type="pipewire" port-type="pipewire-midi">
   <output node="Midi-Bridge" port="Client-130:port-0"/>
   <input node="Midi-Bridge" port="Nuked SC55:Nuked SC55"/>
  </item>
  <item node-type="pipewire" port-type="pipewire-video">
   <output node="Integrated IR Camera (V4L2)" port="Integrated IR Camera:out_0"/>
   <input node="kwin_wayland" port="obs:in_0"/>
  </item>
  <item node-type="pipewire" port-type="pipewire-audio">
   <output node="nuked-sc55" port="nuked-sc55:output_FR"/>
   <input node="K07" port="K07:playback_FR"/>
  </item>
  <item node-type="pipewire" port-type="pipewire-audio">
   <output node="woof" port="woof:output_FL"/>
   <input node="Built-in Audio Analog Stereo" port="ALC257 Analog:playback_FL"/>
  </item>
 </items>
</patchbay>

